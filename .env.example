# Copy to .env (never commit it). All optional.

# Require this key on the API (header X-API-Key) - set it before listening on 0.0.0.0
SOC_API_KEY=
SOC_HOST=127.0.0.1
SOC_PORT=8080
# dry_run (default) or enforce
SOC_RESPONSE_MODE=dry_run
# Where the database, logs, model and raw log drop folder live (default ./data)
# SOC_DATA_DIR=

# Online reputation lookups (Threat Intel -> Lookup)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Notifications (enable the channel in config/response.yaml)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SOC_WEBHOOK_URL=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Response integrations (enforce mode)
EDR_ISOLATE_URL=
IDENTITY_DISABLE_URL=

# Optional integrations
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ELASTIC_URL=http://localhost:9200
ELASTIC_USER=
ELASTIC_PASSWORD=
